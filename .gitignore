# .gitignore para trabajos y proyectos de Angular, Node.js y Capacitor

# ========================================
# DEPENDENCIAS
# ========================================

**/node_modules/


# ========================================
# ANGULAR
# ========================================

**/dist/
**/.angular/
**/tmp/
**/out-tsc/
**/bazel-out/


# ========================================
# NODE.JS
# ========================================

**/npm-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.log


# ========================================
# CAPACITOR / ANDROID / GRADLE
# ========================================

**/.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/


# ========================================
# TESTING / COVERAGE
# ========================================

**/coverage/
**/__screenshots__/
testem.log


# ========================================
# IDEs Y EDITORES
# ========================================

**/.idea/
**/.vscode/
.history/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.sass-cache/


# ========================================
# VARIABLES DE ENTORNO
# ========================================

**/.env
**/.env.*
!**/.env.example


# ========================================
# ARCHIVOS DEL SISTEMA
# ========================================

.DS_Store
**/.DS_Store
Thumbs.db


# ========================================
# ARCHIVOS TEMPORALES
# ========================================

**/*.tmp
**/*.temp
**/*.swp


# ========================================
# OTROS ARCHIVOS GENERADOS
# ========================================

/connect.lock
/libpeerconnection.log
/typings


# ========================================
# CARPETAS LOCALES QUE NO SE PUBLICAN
# ========================================

/proyecto/
